# ── Database (MySQL 8 in production; MariaDB acceptable for dev) ──────────────
# Dedicated least-privilege app user — NEVER root (SPEC §8).
DATABASE_URL="mysql://cozgut_app:devpass@localhost:3306/cozgut"
# Shadow DB for `prisma migrate dev` (dev only).
SHADOW_DATABASE_URL="mysql://cozgut_app:devpass@localhost:3306/cozgut_shadow"

# ── Auth (generate strong random values at setup) ────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=3000
# CORS origins locked to LAN (comma-separated). Empty = allow same LAN dev.
CORS_ORIGINS="http://localhost:5173"

# ── Client (Vite) ────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3000"
