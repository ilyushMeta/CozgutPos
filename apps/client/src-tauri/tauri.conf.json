{
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Çözgüt POS",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "open": true }
    },
    "bundle": {
      "active": true,
      "identifier": "com.cozgut.pos",
      "icon": [],
      "targets": ["msi", "nsis"]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Çözgüt POS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
